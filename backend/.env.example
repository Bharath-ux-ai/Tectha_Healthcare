# PostgreSQL (recommended). Leave unset to use the zero-setup SQLite file ./tecthha.db
DATABASE_URL=postgresql+psycopg://tecthha:tecthha@localhost:5432/tecthha
# CHANGE THIS before any shared deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=12
CORS_ORIGINS=http://localhost:3000
# Seed synthetic demo data on first start (empty database only)
SEED_DEMO_DATA=true
